import { useEffect, useRef, useCallback } from 'react';
import cytoscape from 'cytoscape';
import fcose from 'cytoscape-fcose';
cytoscape.use(fcose);
import { NODE_STYLES, COMPOUND_STYLES, TURN_EDGE_STYLES, BUNDLED_EDGE_STYLES, CATEGORY_EDGE_STYLES, SCRIPT_CARD_STYLES, OPERATION_NODE_STYLES, L2_DETAIL_STYLES } from '../utils/graphStyles';

const TABLE_HDR_H = 26;
const FIELD_H = 34;  // increased from 22 to prevent label overlap
const TABLE_MIN_H = 80;

export default function useCytoscapeGraph(containerRef, graphData, options = {}) {
  const cyRef = useRef(null);
  const optsRef = useRef(options);
  optsRef.current = options;

  useEffect(() => {
    if (!containerRef.current || !graphData) return;
    let { nodes, edges } = graphData;
    if (!nodes || nodes.length === 0) return;

    // ── Phase 0: Build lookups ──
    const tablePos = {};
    const fieldParent = {};
    const fieldsByParent = {};

    nodes.forEach(n => {
      const d = n.data || {};
      const t = d.type || '';
      if (t.endsWith('_table') || t === 'query_output' || t === 'cte_table') {
        tablePos[d.id] = { x: d.x || 0, y: d.y || 0 };
      }
      if (t === 'field' && d.parent) {
        fieldParent[d.id] = d.parent;
        if (!fieldsByParent[d.parent]) fieldsByParent[d.parent] = [];
        fieldsByParent[d.parent].push(n);
      }
    });

    // Sort fields and compute relative positions
    const fieldRelPos = {};
    Object.entries(fieldsByParent).forEach(([parentId, fields]) => {
      fields.sort((a, b) => {
        const ad = a.data || {}, bd = b.data || {};
        return (ad.label || '').localeCompare(bd.label || '');
      });
      fields.forEach((f, i) => {
        fieldRelPos[f.data.id] = {
          rx: 8,
          ry: TABLE_HDR_H + 4 + i * FIELD_H
        };
      });
    });

    // ── L2 Layout: compute table positions when backend doesn't provide them ──
    const hasScriptNodes = nodes.some(n => (n.data || {}).type === 'script_node');
    const needsLayout = !hasScriptNodes && Object.keys(tablePos).length > 0 &&
      Object.values(tablePos).every(p => p.x === 0 && p.y === 0);
    
    if (needsLayout) {
      // Build adjacency from edges
      const adjIn = {};
      const adjOut = {};
      edges.forEach(e => {
        const ed = e.data || {};
        const s = ed.source, t = ed.target;
        if (!adjOut[s]) adjOut[s] = [];
        adjOut[s].push(t);
        if (!adjIn[t]) adjIn[t] = [];
        adjIn[t].push(s);
      });

      // Classify table nodes by row
      const X_SPACING = 200, Y_SPACING = 220;
      let colIdx = [0, 0, 0]; // source=0, intermediate=1, output=2
      
      Object.keys(tablePos).forEach(tid => {
        const hasIncoming = (adjIn[tid] || []).length > 0;
        const hasOutgoing = (adjOut[tid] || []).length > 0;
        let row = 1; // default intermediate
        if (hasIncoming && !hasOutgoing) row = 2; // output
        else if (!hasIncoming && hasOutgoing) row = 0; // source
        
        const c = colIdx[row]++;
        tablePos[tid] = { x: 100 + c * X_SPACING, y: 60 + row * Y_SPACING };
        
        // Also update the node data
        const n = nodes.find(nn => (nn.data || {}).id === tid);
        if (n) {
          n.data = n.data || {};
          n.data.x = tablePos[tid].x;
          n.data.y = tablePos[tid].y;
        }
      });
    }

    // ── Phase 1: Transform nodes ──
    nodes = nodes.map(n => {
      const d = { ...n.data };
      const t = d.type || '';

      if (t === 'field') {
        delete d.parent;
      }

      let px = d.x, py = d.y;

      if (t === 'field') {
        const pId = fieldParent[d.id];
        const tp = tablePos[pId] || { x: 0, y: 0 };
        const rp = fieldRelPos[d.id] || { rx: 8, ry: 34 };
        px = tp.x + rp.rx;
        py = tp.y + rp.ry;
        d.x = px;
        d.y = py;
        // Store which table this field belongs to (for drag-follow)
        d._tableParent = pId;
      }

      // Dynamic table height
      if (t.endsWith('_table') || t === 'query_output' || t === 'cte_table') {
        const flds = fieldsByParent[d.id] || [];
        const neededH = flds.length > 0
          ? TABLE_HDR_H + 8 + flds.length * FIELD_H
          : TABLE_MIN_H;
        d._tableHeight = Math.max(TABLE_MIN_H, neededH);
      }

      const pos = {};
      if (px !== undefined) pos.x = px;
      if (py !== undefined) pos.y = py;

      return { data: d, position: pos };
    });

    const cy = cytoscape({
      container: containerRef.current,
      style: [...NODE_STYLES, ...COMPOUND_STYLES, ...TURN_EDGE_STYLES, ...BUNDLED_EDGE_STYLES, ...CATEGORY_EDGE_STYLES, ...SCRIPT_CARD_STYLES, ...OPERATION_NODE_STYLES, ...L2_DETAIL_STYLES],
      layout: { name: 'preset' },
      wheelSensitivity: 0.3,
    });

    cy.add([...nodes, ...edges]);

    cy.ready(() => {
      // Dynamic table heights
      cy.nodes('[type$="_table"], [type="query_output"], [type="cte_table"]').forEach(n => {
        const h = n.data('_tableHeight');
        if (h) {
          n.style('height', h + 'px');
          n.style('min-height', h + 'px');
        }
      });

      // Position via preset layout
      cy.layout({
        name: 'preset',
        positions: (node) => {
          const x = node.data('x');
          const y = node.data('y');
          if (x !== undefined && y !== undefined) return { x, y };
          return node.position();
        },
        fit: false,
        animate: false,
        animationDuration: 0,
      }).run();

      // ── DRAG: table nodes drag their fields along ──
      // Build table→fields lookup from data._tableParent
      const tableFields = {};
      cy.nodes('[type="field"]').forEach(f => {
        const tp = f.data('_tableParent');
        if (tp) {
          if (!tableFields[tp]) tableFields[tp] = [];
          tableFields[tp].push(f);
        }
      });

      // Track drag start positions for delta calculation
      const dragStartPos = {};

      cy.on('drag', 'node[type$="_table"], node[type="query_output"], node[type="cte_table"]', (evt) => {
        const node = evt.target;
        const nid = node.id();
        const curPos = node.position();
        const fields = tableFields[nid] || [];

        if (!dragStartPos[nid]) {
          dragStartPos[nid] = { x: curPos.x, y: curPos.y };
        }

        const start = dragStartPos[nid];
        const dx = curPos.x - start.x;
        const dy = curPos.y - start.y;

        fields.forEach(f => {
          const fx = f.data('x') + dx;
          const fy = f.data('y') + dy;
          f.position({ x: fx, y: fy });
          f.data('x', fx);
          f.data('y', fy);
        });

        // Update start for next drag tick
        dragStartPos[nid] = { x: curPos.x, y: curPos.y };
      });

      // Reset drag tracking on dragfree
      cy.on('dragfree', 'node[type$="_table"], node[type="query_output"], node[type="cte_table"]', (evt) => {
        const nid = evt.target.id();
        delete dragStartPos[nid];
      });

      // Role badges
      cy.nodes('[type="script_node"]').forEach(n => {
        const roles = n.data('roles') || [];
        if (!roles.length) return;
        const short = {REF:'R',JOIN:'J',FILTER:'F',AGGREGATE:'A',WINDOW:'W',TRANSFORM:'T',COMPUTED:'C',SCHEMA:'S',TABLE_FLOW:'TF','DML TARGET':'DT',CORRELATED:'CR'};
        const abbr = roles.slice(0, 4).map(r => short[r] || r.slice(0, 2));
        const lbl = n.data('label') || '';
        const hasBadge = /\n(R|J|F|A|W|T|C|S|TF|DT|CR)/.test(lbl);
        if (!hasBadge) {
          n.data('label', lbl + '\n' + abbr.join(' '));
        }
      });

      cy.fit(undefined, 80);
    });

    // Event handlers
    if (optsRef.current.onTap) cy.on('tap', 'node', optsRef.current.onTap);
    if (optsRef.current.onDblTap) cy.on('dbltap', 'node', optsRef.current.onDblTap);
    if (optsRef.current.onHoverEnter) cy.on('mouseover', 'node', optsRef.current.onHoverEnter);
    if (optsRef.current.onHoverLeave) cy.on('mouseout', 'node', optsRef.current.onHoverLeave);
    if (optsRef.current.onEdgeTap) cy.on('tap', 'edge', optsRef.current.onEdgeTap);
    if (optsRef.current.onEdgeHover) cy.on('mouseover', 'edge', optsRef.current.onEdgeHover);
    if (optsRef.current.onBgTap) cy.on('tap', optsRef.current.onBgTap);

    cyRef.current = cy;
    window.__cy = cy;

    return () => {
      if (cy && !cy.destroyed()) cy.destroy();
      cyRef.current = null;
    };
  }, [graphData, containerRef]);

  const fit = useCallback((padding = 50) => {
    if (cyRef.current && !cyRef.current.destroyed()) {
      cyRef.current.fit(undefined, padding);
    }
  }, []);

  const highlightPath = useCallback((nodeIds) => {
    if (!cyRef.current) return;
    const cy = cyRef.current;
    if (cy.destroyed()) return;
    cy.elements().removeClass('dimmed').removeClass('path-highlighted');
    const idSet = new Set(nodeIds);
    cy.nodes().forEach(n => {
      if (idSet.has(n.id())) n.addClass('path-highlighted');
      else n.addClass('dimmed');
    });
    cy.edges().forEach(e => {
      if (idSet.has(e.data('source')) && idSet.has(e.data('target')))
        e.addClass('path-highlighted');
      else e.addClass('dimmed');
    });
  }, []);

  const setLayout = useCallback((name) => {
    if (!cyRef.current) return;
    const cy = cyRef.current;
    if (cy.destroyed()) return;
    cy.layout({ name }).run();
  }, []);

  const getSelected = useCallback(() => {
    if (!cyRef.current) return null;
    const cy = cyRef.current;
    if (cy.destroyed()) return null;
    const sel = cy.$(':selected');
    return sel.length > 0 ? sel.data() : null;
  }, []);

  return { cyRef, fit, highlightPath, setLayout, getSelected };
}
