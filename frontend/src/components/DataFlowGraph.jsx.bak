import React, { useRef, useState } from 'react';
import useCytoscapeGraph from '../hooks/useCytoscapeGraph';
import DataFlowLegend from './DataFlowLegend';

/**
 * L1/L2 Data Flow Graph component.
 * Uses backend-provided snake-wrap positions (preset layout).
 * No additional frontend layout — backend positions are canonical.
 */
export default function DataFlowGraph(props) {
  const { graphData, level, onOpenL2, scriptInfo, onScriptInfoChange,
    onToggleFilter, l2Filtered, l2TotalNodes, l2FilteredNodes,
    onTableClick, activeTable, onClearTableFilter,
    onEdgeClick, selectedEdgeId, breadcrumb, refitKey } = props;
  
  const containerRef = useRef(null);
  const [edgeHover, setEdgeHover] = useState(null);

  const { cyRef, fit } = useCytoscapeGraph(containerRef, graphData, {
    showRoleBadges: true,
    onTap: (e) => {
      const data = e.target.data();
      if (level === 'L1') {
        if (data.type === 'script_node') {
          onScriptInfoChange?.({ id: data.id, label: data.label || data.script_name,
            script_name: data.script_name, total_variables: data.total_variables,
            input_tables: data.input_tables, output_tables: data.output_tables, roles: data.roles || [] });
        } else if (data.type && data.type.endsWith('_table')) {
          onTableClick?.(data.table_name || data.label);
        }
      }

    },
    onDblTap: (e) => {
      if (level === 'L1' && e.target.data().type === 'script_node') {
        const sn = e.target.data().script_name || (e.target.data('label') || '').replace(/\n.*$/, '').trim();
        if (sn) onOpenL2?.(e.target.data().id, sn);
      }
    },
    onHoverEnter: (e) => {
      if (level === 'L1') {
        const d = e.target.data();
        if (d.type === 'script_node' || d.type?.endsWith?.('_table')) e.target.style('cursor', 'pointer');
        if (e.target.isEdge?.()) setEdgeHover({ type: e.target.data().edge_type || 'edge', desc: e.target.data().category || '', color: e.target.data().color || '#5DADE2' });
      }
    },
    onHoverLeave: () => setEdgeHover(null),
  });

  // Keyboard shortcut: press 'f' to fit
  React.useEffect(() => {
    const h = (e) => {
      if (!cyRef.current || (e.key !== 'f' && e.key !== 'F')) return;
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      cyRef.current.fit(undefined, 50);
    };
    window.addEventListener('keydown', h);
    return () => window.removeEventListener('keydown', h);
  }, []);

  return (
    <div className="dataflow-graph-container">
      <div className="graph-toolbar">
        <span className="graph-level-badge">{level === 'L1' ? 'Cross-Script Pipeline' : 'Per-Script Detail'}</span>
        <button className="btn btn-outline btn-sm" onClick={() => fit(50)}>Fit</button>
        {level === 'L2' && onToggleFilter && (
          <button className={`btn btn-sm ${l2Filtered ? 'btn-outline' : 'btn-active'}`} onClick={onToggleFilter}>
            {l2Filtered ? 'Show All' : 'Show Relevant'}
          </button>
        )}
      </div>
      <DataFlowLegend level={level === 'L1' ? 'L1' : 'L2'} />
      <div className="graph-extra-controls">
        <button className="btn btn-outline btn-sm" onClick={() => fit(100)}>🗺</button>
        <button className="btn btn-outline btn-sm" onClick={() => {
          const c = cyRef.current; if (!c) return;
          const a = document.createElement('a');
          a.href = c.png({ full: true, scale: 2, bg: '#1a1a2e' });
          a.download = `dataflow-${level}-${new Date().toISOString().slice(0,10)}.png`; a.click();
        }}>📷</button>
      </div>
      <div ref={containerRef} className="graph-canvas" style={{ width: '100%', height: 'calc(100% - 80px)' }} />
      {edgeHover && (
        <div className="edge-tooltip" style={{ position: 'absolute', bottom: 60, left: '50%', transform: 'translateX(-50%)', background: 'rgba(0,0,0,0.9)', border: `2px solid ${edgeHover.color}`, borderRadius: 6, padding: '6px 14px', zIndex: 10, color: '#fff', fontSize: '0.8rem', pointerEvents: 'none' }}>
          <span style={{ color: edgeHover.color, fontWeight: 'bold' }}>{edgeHover.type}</span>
          {edgeHover.desc && <span style={{ color: '#aaa', marginLeft: 8 }}>{edgeHover.desc}</span>}
        </div>
      )}
      {scriptInfo && level === 'L1' && (
        <div className="script-info-popup">
          <div className="sip-header">{scriptInfo.label}<button onClick={() => onScriptInfoChange?.(null)}>×</button></div>
          <div>Variables: {scriptInfo.total_variables || '?'}</div>
          <div>Inputs: {(scriptInfo.input_tables || []).join(', ') || 'none'}</div>
          <div>Outputs: {(scriptInfo.output_tables || []).join(', ') || 'none'}</div>
          <div style={{ fontSize: '0.7rem', color: '#888', marginTop: 4 }}>Double-click to open detail view</div>
        </div>
      )}
    </div>
  );
}
