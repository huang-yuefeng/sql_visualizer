# =============================================================================
# GPS SQL Data Flow Visualizer — Development Compose
#
# Start:
#   docker compose up              # backend + frontend
#   docker compose up backend      # backend only (frontend already built)
#
# The backend serves the pre-built frontend from backend/app/static/.
# For frontend hot-reload, use:
#   docker compose up frontend     # Vite dev server at :5173
# =============================================================================

services:
  backend:
    build:
      context: .
      dockerfile: Dockerfile.dev
    image: gps-sql-visualizer:dev
    container_name: gps-sql-backend
    ports:
      - "8000:8000"
    volumes:
      - ./backend/app:/app/backend/app          # hot-reload Python code
      - ./backend/tests:/app/backend/tests
      - ./samples:/app/samples
      - ./VERSION:/app/VERSION
      - backend_cache:/app/backend/analysis_cache
      - workspace_data:/tmp/workspaces
    environment:
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
      - DEBUG=${DEBUG:-true}
    working_dir: /app/backend
    command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload
    restart: unless-stopped

  frontend:
    build:
      context: .
      dockerfile: Dockerfile.dev
    image: gps-sql-visualizer:dev
    container_name: gps-sql-frontend
    ports:
      - "5173:5173"
    volumes:
      - ./frontend/src:/app/frontend/src        # hot-reload JSX
      - ./frontend/public:/app/frontend/public
      - ./frontend/index.html:/app/frontend/index.html
      - ./frontend/vite.config.js:/app/frontend/vite.config.js
      - frontend_modules:/app/frontend/node_modules
    working_dir: /app/frontend
    command: npm run dev -- --host 0.0.0.0
    restart: unless-stopped

volumes:
  backend_cache:
  frontend_modules:
  workspace_data:
